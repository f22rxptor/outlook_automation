# ==============================================================================
# CHEMICAL PROCUREMENT PIPELINE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: MICROSOFT GRAPH API (ENTERPRISE O365 / AZURE AD CLIENT CREDENTIALS)
# ------------------------------------------------------------------------------
# Register an App in Azure Portal (portal.azure.com):
# Permissions needed: Mail.ReadWrite (Application) under Microsoft Graph
AZURE_TENANT_ID=your-azure-tenant-id-guid
AZURE_CLIENT_ID=your-azure-client-id-guid
AZURE_CLIENT_SECRET=your-azure-client-secret-value
OUTLOOK_MAILBOX=enquiries@company.com

# ------------------------------------------------------------------------------
# OPTION 2: DIRECT IMAP (OUTLOOK / GMAIL / CORPORATE MAIL WITH APP PASSWORD)
# ------------------------------------------------------------------------------
# For Microsoft Outlook/365: IMAP_HOST=outlook.office365.com, PORT=993
# For Gmail: IMAP_HOST=imap.gmail.com, PORT=993
# Note: Generate an 'App Password' from your Microsoft/Google Account Security page
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=enquiries@company.com
IMAP_PASSWORD=your_app_password_here

# ------------------------------------------------------------------------------
# CLAUDE API (ANTHROPIC SDK) FOR STRUCTURED CHEMICAL EXTRACTION
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ------------------------------------------------------------------------------
# OPTIONAL: REAL-TIME NOTIFICATION WEBHOOKS (SLACK / TEAMS)
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
